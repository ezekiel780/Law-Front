{
  "name": "nwlr-v2",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run clean:legacy-runtime && nuxt",
    "build": "npm run clean:legacy-runtime && nuxt build",
    "start": "nuxt start",
    "generate": "npm run clean:legacy-runtime && nuxt generate",
    "lint:prettier": "prettier --check .",
    "lint": "npm run lint:prettier",
    "lintfix": "prettier --write --list-different .",
    "clean:legacy-runtime": "node scripts/remove-legacy-runtime.js",
    "test": "npm run clean:legacy-runtime && node scripts/run-regression-tests.js",
    "validate:deploy": "npm run clean:legacy-runtime && node scripts/run-regression-tests.js && nuxt build",
    "deploy": "git pull --ff-only && npm install --no-package-lock --no-audit --no-fund && npm run validate:deploy && pm2 restart nwlr-front --update-env"
  },
  "dependencies": {
    "@nuxtjs/axios": "^5.13.6",
    "@nuxtjs/google-gtag": "^1.0.4",
    "@nuxtjs/moment": "^1.6.1",
    "@nuxtjs/pwa": "^3.3.5",
    "@nuxtjs/sitemap": "2.4.0",
    "cookie": "^0.5.0",
    "core-js": "^3.25.3",
    "country-state-city": "^3.2.1",
    "flipbook-vue": "0",
    "gsap": "^3.12.2",
    "html2canvas": "^1.4.1",
    "js-cookie": "^3.0.5",
    "nuxt": "^2.15.8",
    "preline": "^1.8.0",
    "vue": "^2.7.10",
    "vue-notification": "^1.3.20",
    "vue-server-renderer": "^2.7.10",
    "vue-slick-carousel": "^1.0.6",
    "vue-template-compiler": "^2.7.10",
    "vuelidate": "^0.7.7",
    "vuex": "^3.6.2",
    "vuex-persistedstate": "^4.1.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.14",
    "eslint-config-prettier": "^8.5.0",
    "file-loader": "^6.2.0",
    "postcss": "^8.4.23",
    "prettier": "^2.7.1",
    "tailwindcss": "^3.3.1"
  },
  "config": {
    "nuxt": {
      "host": "0.0.0.0",
      "port": "80"
    }
  }
}
